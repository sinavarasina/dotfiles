{
  "workspace": {
    "library": [
      "/usr/share/hypr/stubs"
    ]
  },
  "diagnostics": {
    "globals": ["hl", "V"]
  },
  "format": {
    "enable": true,
    "defaultConfig": {
      "align_continuous_assign_statement": "true",
      "align_continuous_rect_table_field": "true",
      "align_array_table": "true",
      "keep_simple_control_block_one_line": "true",
      "max_line_length": "150"
    }
  }
}
