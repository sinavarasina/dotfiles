{
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "spacing": 0,
    "modules-left": ["custom/logo", "custom/sep-right-play-blue", "hyprland/workspaces#active", "custom/sep-right-K-red", "custom/hyprland_window_scroll", "custom/sep-left-play-blue",  "hyprland/workspaces#inactive", "custom/sep-right-slash-blue"],
    "modules-center": [],
    "modules-right": ["battery", "cpu", "memory","custom/sep-left-slash-blue" ,"clock"],

    "custom/logo": {
        "format": " ",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    "custom/sep-right-play-blue": {
        "format": "",
        "tooltip": false
    },

    "hyprland/workspaces#active": {
        "format": "[{id}]:",
        "active-only": true
    },

    "custom/sep-right-K-red": {
        "format": "",
        "tooltip": false
    },

    "hyprland/workspaces#inactive": {
        "format": "{id}",
        "hide-active": true
    },

    "custom/hyprland_window_scroll": {
        "format": "{}",
        "exec": "~/.config/waybar/bin/hyprland_window_scroll"
    },

    "custom/sep-left-play-blue": {
        "format": "",
        "tooltip": false
    },

    "custom/sep-right-slash-blue": {
        "format": "",
        "tooltip": false
    },

    "custom/sep-left-slash-blue": {
        "format": "",
        "tooltip": false
    },
 
}
