{
    "layer": "bottom",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "modules-left": [
        "custom/logo",
        "custom/sep-arrow-r-fg_crust-bg_mantle",
        "hyprland/workspaces#active",
        "custom/sep-arrow-r-fg_mantle-bg_trans",
        "custom/sep-curve-l-fg_mantle-bg_trans",
        "hyprland/workspaces#inactive",
        "custom/sep-slash-r-fg_mantle-bg_trans",
        "custom/sep-slash-r-thin-fg_surface0-bg_trans",
        "custom/sep-slash-l-inv-fg_crust-bg_trans",
        "custom/hyprland_window_scroll",
        "custom/sep-slash-r-fg_crust-bg_trans",
        "custom/sep-slash-r-thin-fg_surface0-bg_trans"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/sep-slash-l-fg_mantle-bg_trans",
        "tray",
        "cpu",
        "memory",
        "wireplumber",
        "network",
        "group/expandable-mon",
        "custom/sep-curve-r-fg_mantle-bg_trans",
        "custom/sep-arrow-l-thin-fg_surface0-bg_trans",
        "custom/sep-arrow-l-fg_crust-bg_trans",
        "clock"
    ],

    // --- CORE MODULES ---
    "custom/logo": {
        "format": " ",
        "tooltip": false,
        "on-click": "wofi --show drun --allow-images"
    },
    "hyprland/workspaces#active": {
        "format": "[{id}]:",
        "active-only": true
    },
    "hyprland/workspaces#inactive": {
        "format": "{id}",
        "hide-active": true
    },
    "custom/hyprland_window_scroll": {
        "format": "{}",
        "exec": "~/.config/waybar/bin/hyprland_window_scroll",
        "escape": true
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "wireplumber": {
        "format": "{icon} {volume}%\n󰍬 {source_volume}%",
        "format-muted": "󰝟 0%\n󰍭 0%",
        "format-icons": ["", "", ""],
        "max-volume": 150,
        "scroll-step": 1,
        "tooltip": true,
        "tooltip-format": "Device: {node_name}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "interface": "enp9s0",
        "interval": 1,
        "format": " {bandwidthUpBytes}\n {bandwidthDownBytes}",
        "format-disconnected": "󰤭 0/0",
        "tooltip-format": "{ifname} ({ipaddr})\nGateway: {gwaddr}\nUp: {bandwidthUpBytes}/s\nDown: {bandwidthDownBytes}/s\nSignal: {signalStrength}% ({signaldBm} dBm)",
        "tooltip-format-wifi": "{ifname} via {essid}\nSignal: {signalStrength}% ({signaldBm} dBm)\nIP: {ipaddr}\nGateway: {gwaddr}\nUp: {bandwidthUpBytes}/s\nDown: {bandwidthDownBytes}/s\nFrequency: {frequency} GHz",
        "tooltip-format-ethernet": "{ifname} (Ethernet)\nIP: {ipaddr}\nGateway: {gwaddr}\nUp: {bandwidthUpBytes}/s\nDown: {bandwidthDownBytes}/s",
        "tooltip-format-disconnected": "Disconnected"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "  {:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%H:%M:%S}</big>\n<tt><small>{calendar}</small></tt>",
        
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#cba6f7'><b>{}</b></span>",
                "days":       "<span color='#cdd6f4'>{}</span>",
                "weeks":      "<span color='#6c7086'>W{}</span>",
                "weekdays":   "<span color='#89b4fa'><b>{}</b></span>",
                "today":      "<span background='#f38ba8' color='#11111b'><b> {} </b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "cpu": {
        "interval": 1,
        "format": " {usage}%\n󰓅 {avg_frequency}GHz",
        "tooltip": true,
        "tooltip-format": "Usage: {usage}%\nLoad: {load}\nAvg Freq: {avg_frequency}GHz\nMax Freq: {max_frequency}GHz\nMin Freq: {min_frequency}GHz",
        "on-click": "footclient btop"
    },
    "memory": {
        "interval": 1,
        "format": " {percentage}%\n󰾆 {used:0.1f}G",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB ({percentage}%)\nSwap: {swapUsed:0.1f}GB / {swapTotal:0.1f}GB ({swapPercentage}%)",
        "on-click": "footclient btop"
    },
    "disk": {
        "interval": 30,
        "format": " {specific_used:>5.1f}G Used\n {specific_free:>5.1f}G Free", 
        "unit": "GB",
        "tooltip": true,
        "tooltip-format": "Path: {path}\nTotal: {total}\nUsed: {used} ({percentage_used}%)\nFree: {free} ({percentage_free}%)",
        "on-click": "footclient btop",
        "path": "/"
    },
    "bluetooth": {
        "format": " {status}\n󰥉 {device_battery_percentage}%",
        "format-disabled": "󰂲 Disabled\n󰥉 N/A",
        "format-connected": "󰂱 {status}\n󰥉 {device_battery_percentage}%",
        "tooltip": true,
        "tooltip-format": "Controller: {controller_alias}\nStatus: {status}",
        "tooltip-format-connected": "Controller: {controller_alias}\nConnections: {num_connections}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "󰂱 {device_alias} ({device_battery_percentage}% Battery)",
        "on-click": "footclient bluetui"
    },

    // --- SEPARATOR MODULES ---
    "custom/sep-arrow-r-fg_crust-bg_mantle":            { "format": "", "tooltip": false },
    "custom/sep-arrow-r-fg_mantle-bg_trans":            { "format": "", "tooltip": false },
    "custom/sep-curve-l-fg_mantle-bg_trans":            { "format": "", "tooltip": false },
    "custom/sep-slash-r-fg_mantle-bg_trans":            { "format": "", "tooltip": false },
    "custom/sep-slash-r-thin-fg_surface0-bg_trans":     { "format": "", "tooltip": false },
    "custom/sep-slash-r-thin-inv-fg_surface0-bg_trans": { "format": "", "tooltip": false },
    "custom/sep-slash-l-inv-fg_crust-bg_trans":         { "format": "", "tooltip": false },
    "custom/sep-slash-r-fg_crust-bg_trans":             { "format": "", "tooltip": false },
    "custom/sep-slash-r-inv-fg_mantle-bg_trans":        { "format": "", "tooltip": false },
    "custom/sep-slash-l-fg_mantle-bg_trans":            { "format": "", "tooltip": false },
    "custom/sep-slash-r-inv-fg_crust-bg_trans":         { "format": "", "tooltip": false },
    "custom/sep-curve-r-fg_mantle-bg_trans":            { "format": "", "tooltip": false },
    "custom/sep-arrow-l-thin-fg_surface0-bg_trans":     { "format": "", "tooltip": false },
    "custom/sep-arrow-l-fg_crust-bg_trans":             { "format": "", "tooltip": false },

    "custom/expand_sign": {
        "format": "exp\n  ",
        "tooltip": false
    },

    // --- GROUP MODULES ---
    "group/expandable-mon": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/expand_sign",
            "disk",
            "bluetooth"
        ]
    }
}
